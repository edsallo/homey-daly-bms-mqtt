{
  "id": "daly-monitor",
  "name": {
    "en": "Daly BMS",
    "ru": "Daly BMS"
  },
  "class": "battery",
  "energy": {
    "batteries": [
      "INTERNAL"
    ]
  },
  "capabilities": [
    "measure_status",
    "bms_voltage",
    "measure_capacity_ah",
    "bms_current",
    "measure_battery",
    "measure_delta",
    "measure_balancing_current",
    "bms_temperature",
    "mos_temperature",
    "alarm_battery",
    "measure_power",
    "charge_fet",
    "discharge_fet",
    "balance_active",
    "relay_active",
    "relay_manual",
    "meter_discharge_ah",
    "meter_charge_ah",
    "measure_cycles",
    "measure_remaining_energy",
    "measure_cell_count",
    "measure_heartbeat",
    "measure_cell_high_index",
    "measure_cell_low_index",
    "measure_cell_high_voltage",
    "measure_cell_low_voltage",
    "measure_wifi_rssi",
    "measure_status_code",
    "bms_failure",
    "alarm_generic"
  ],
  "pair": [
    {
      "id": "manual"
    }
  ],
  "settings": [
    {
      "id": "mqttBroker",
      "type": "text",
      "label": {
        "en": "MQTT Broker IP",
        "ru": "IP брокера MQTT"
      },
      "value": ""
    },
    {
      "id": "mqttPort",
      "type": "number",
      "label": {
        "en": "MQTT Port",
        "ru": "Порт MQTT"
      },
      "value": 1883,
      "min": 1,
      "max": 65535
    },
    {
      "id": "mqttTopic",
      "type": "text",
      "label": {
        "en": "MQTT Topic",
        "ru": "Топик MQTT"
      },
      "value": "BMS01"
    },
    {
      "id": "mqttUser",
      "type": "text",
      "label": {
        "en": "MQTT Username",
        "ru": "Имя пользователя MQTT"
      },
      "value": ""
    },
    {
      "id": "mqttPassword",
      "type": "password",
      "label": {
        "en": "MQTT Password",
        "ru": "Пароль MQTT"
      },
      "value": ""
    },
    {
      "id": "mqttTls",
      "type": "checkbox",
      "label": {
        "en": "Use TLS (mqtts)",
        "ru": "Защищённое соединение TLS"
      },
      "value": false
    },
    {
      "id": "lowBattery",
      "type": "number",
      "label": {
        "en": "Low battery threshold (%)",
        "ru": "Порог низкого заряда (%)"
      },
      "value": 20,
      "min": 0,
      "max": 100
    },
    {
      "id": "telemetryTimeout",
      "type": "number",
      "label": {
        "en": "Telemetry timeout (seconds, 0 = off)",
        "ru": "Тайм-аут данных (сек., 0 = выключен)"
      },
      "value": 300,
      "min": 0,
      "max": 86400
    }
  ],
  "connectivity": [
    "lan"
  ],
  "platforms": [
    "local"
  ],
  "images": {
    "small": "/drivers/daly-monitor/assets/images/small.png",
